			<if test="bean.createdTime!=null">
				 created_time = VALUES(created_time),
			</if>
			<if test="bean.updatedTime!=null">
				 updated_time = VALUES(updated_time),
			</if>
		 </trim>
	</insert>

	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.evernight.base.entity.po.File" useGeneratedKeys="true" keyProperty="fileId">
		 INSERT INTO file(
