				 file_type,
			</if>
			<if test="bean.fileSize != null">
				 file_size,
			</if>
			<if test="bean.fileHash != null">
				 file_hash,
			</if>
			<if test="bean.isDeleted != null">
				 is_deleted,
			</if>
			<if test="bean.createdTime != null">
				 created_time,
			</if>
			<if test="bean.updatedTime != null">
				 updated_time,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.userId!=null">
				 #{bean.userId},
			</if>
			<if test="bean.fileName!=null">
				 #{bean.fileName},
			</if>
			<if test="bean.filePath!=null">
				 #{bean.filePath},
			</if>
			<if test="bean.fileType!=null">
				 #{bean.fileType},
			</if>
			<if test="bean.fileSize!=null">
				 #{bean.fileSize},
			</if>
			<if test="bean.fileHash!=null">
				 #{bean.fileHash},
			</if>
			<if test="bean.isDeleted!=null">
				 #{bean.isDeleted},
			</if>
			<if test="bean.createdTime!=null">
				 #{bean.createdTime},
			</if>
			<if test="bean.updatedTime!=null">
				 #{bean.updatedTime},
			</if>
		 </trim>
	</insert>

